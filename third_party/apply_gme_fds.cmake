# NGMV local LGPL source patch, 2026-10-10. Original upstream ZIP stays intact.
foreach(name Nsf_Emu.h Nsf_Emu.cpp nes_cpu_io.h)
 file(SHA256 "${GME_SOURCE_DIR}/gme/${name}" actual)
 file(SHA256 "${CMAKE_CURRENT_LIST_DIR}/gme-fds-patch/${name}" patched)
 if(name STREQUAL "Nsf_Emu.h")
  set(original "26770c9acf216ccfa5e5f0b8f97ce71eec6ca79850031f0b0ca0c7d0260074f8")
 endif()
 if(name STREQUAL "Nsf_Emu.cpp")
  set(original "380857679b888e34a4ce17b2d47af0680de451fe7cbae51f9ee973be120a29a9")
 endif()
 if(name STREQUAL "nes_cpu_io.h")
  set(original "9b3156f00ce6651b744d09300f5f1061cf9d95fbdcaf4f35ed0f7ecba20f84f1")
 endif()
 if(NOT actual STREQUAL original AND NOT actual STREQUAL patched)
  message(FATAL_ERROR "Unexpected libgme source version for ${name}")
 endif()
 configure_file("${CMAKE_CURRENT_LIST_DIR}/gme-fds-patch/${name}" "${GME_SOURCE_DIR}/gme/${name}" COPYONLY)
endforeach()
